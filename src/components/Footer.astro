---
import EditLink from "virtual:starlight/components/EditLink";
import LastUpdated from "virtual:starlight/components/LastUpdated";
import Pagination from "virtual:starlight/components/Pagination";
import config from "virtual:starlight/user-config";
import { Icon } from "@astrojs/starlight/components";
import Button from "./Button.astro";
---

<footer class="sl-flex">
	<div class="meta sl-flex">
		<EditLink />
		<LastUpdated />
	</div>
	<Pagination />
	<Button
		class="contact-cta"
		variant="ghost"
		href="https://app.youform.com/forms/moki0tve"
		target="_blank"
	>
		Contact us
	</Button>
	<div class="carbon-badge-wrap">
		<div id="wcb" class="carbonbadge"></div>
	</div>

	{
		config.credits && (
			<a class="kudos sl-flex" href="https://starlight.astro.build">
				<Icon name={'starlight'} /> {Astro.locals.t('builtWithStarlight.label')}
			</a>
		)
	}
</footer>

<script is:inline src="https://unpkg.com/website-carbon-badges@1.1.3/b.min.js" defer></script>
<script src="https://analytics.ahrefs.com/analytics.js" data-key="pgtzl4ukWaq4/1aDaqXQ3g" async></script>

<style>
	@layer starlight.core {
		footer {
			flex-direction: column;
			gap: 1.5rem;
		}
		.meta {
			gap: 0.75rem 3rem;
			justify-content: space-between;
			flex-wrap: wrap;
			margin-top: 3rem;
			font-size: var(--sl-text-sm);
			color: var(--sl-color-gray-3);
		}
		.meta > :global(p:only-child) {
			margin-inline-start: auto;
		}

		.contact-cta {
			margin-block-start: 0.5rem;
		}

		.carbon-badge-wrap {
			display: flex;
			justify-content: center;
			margin: 0 auto 1rem;
		}

		.kudos {
			align-items: center;
			gap: 0.5em;
			margin: 1.5rem auto;
			font-size: var(--sl-text-xs);
			text-decoration: none;
			color: var(--sl-color-gray-3);
		}
		.kudos:hover {
			color: var(--sl-color-white);
		}
	}

	@layer starlight.components {
		.kudos :global(svg) {
			color: var(--sl-color-orange);
		}
	}
</style>
