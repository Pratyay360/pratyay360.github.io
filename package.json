{
	"name": "docs",
	"type": "module",
	"version": "0.0.1",
	"scripts": {
		"dev": "astro dev",
		"start": "astro dev",
		"build": "paraglide-js compile && astro build",
		"preview": "astro preview",
		"astro": "astro",
		"check:i18n": "inlang check --project ./project.inlang",
