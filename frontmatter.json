{
	"$schema": "https://frontmatter.codes/frontmatter.schema.json",
	"frontMatter.content.pageFolders": [
		{
			"title": "content",
			"path": "[[workspace]]/content"
		},
		{
			"title": "guides",
			"path": "[[workspace]]/content/guides"
		}
	],
	"frontMatter.taxonomy.contentTypes": [
    {
      "name": "default",
      "pageBundle": false,
      "fields": [
        {
          "title": "Title",
          "name": "Title",
          "type": "string"
        },
        {
          "title": "Description",
          "name": "Description",
          "type": "string"
        },
        {
          "title": "Weight",
          "name": "Weight",
          "type": "number"
        },
        {
          "title": "Date",
          "name": "Date",
          "type": "datetime"
        },
        {
          "title": "draft",
          "name": "draft",
          "type": "draft"
        }
      ]
    }
  ]
}
