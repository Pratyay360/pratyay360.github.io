{
  "$schema": "https://frontmatter.codes/frontmatter.schema.json",
  "frontMatter.content.pageFolders": [
    {
      "title": "content",
      "path": "[[workspace]]/content"
    },
    {
      "title": "guides",
      "path": "[[workspace]]/content/guides"
    },
    {
      "title": "forgit",
      "path": "[[workspace]]/content/guides/forgit"
    },
    {
      "title": "forgit",
      "path": "[[workspace]]/content/guides/forgit"
    }
  ],
  "frontMatter.taxonomy.contentTypes": [
    {
      "name": "default",
      "pageBundle": false,
      "fields": [
        {
          "title": "title",
          "name": "title",
          "type": "string"
        },
        {
          "title": "description",
          "name": "description",
          "type": "string"
        },
        {
          "title": "date",
          "name": "date",
          "type": "datetime"
        },
        {
          "title": "updated",
          "name": "updated",
          "type": "datetime"
        },
        {
          "title": "draft",
          "name": "draft",
          "type": "draft"
        },
        {
          "title": "keywords",
          "name": "keywords",
          "type": "string"
        },
        {
          "title": "weight",
          "name": "weight",
          "type": "number"
        },
        {
          "title": "sort_by",
          "name": "sort_by",
          "type": "string"
        },
        {
          "title": "template",
          "name": "template",
          "type": "string"
        },
        {
          "title": "extra",
          "name": "extra",
          "type": "fields",
          "fields": [
            {
              "title": "noindex",
              "name": "noindex",
              "type": "boolean"
            }
          ]
        },
        {
          "title": "tags",
          "name": "tags",
          "type": "tags"
        },
        {
          "title": "isCJKLanguage",
          "name": "isCJKLanguage",
          "type": "boolean"
        },
        {
          "title": "name",
          "name": "name",
          "type": "string"
        },
        {
          "title": "order",
          "name": "order",
          "type": "number"
        }
      ]
    }
  ],
  "frontMatter.git.enabled": true,
  "frontMatter.panel.openOnSupportedFile": true
}